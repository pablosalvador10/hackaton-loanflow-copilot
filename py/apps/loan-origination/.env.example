# ═══════════════════════════════════════════════════════════════════
#  Loan Origination — environment variables
#  Copy this file to .env and fill in the blanks.
# ═══════════════════════════════════════════════════════════════════

# ── Azure AI Foundry ─────────────────────────────────────────────
# Required — get from: AI Foundry portal → your project → Overview
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-id>
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o-mini
# "dev" uses DefaultAzureCredential (az login); "managed_identity" for cloud
FOUNDRY_CREDENTIAL_MODE=dev

# ── Runtime modes ────────────────────────────────────────────────
# inmemory = no Azure storage needed (local dev); cosmos = requires Cosmos vars below
STORAGE_MODE=inmemory
OTEL_EXPORTER=console

# ── MCP: 5 copilot servers (local) ──────────────────────────────
# These run via py/mcp/run_all.py — ports 8010-8014
MCP_IDENTITY_URL=http://localhost:8010/mcp
MCP_PRODUCT_URL=http://localhost:8011/mcp
MCP_CREDIT_URL=http://localhost:8012/mcp
MCP_OFFERS_URL=http://localhost:8013/mcp
MCP_CONTRACT_URL=http://localhost:8014/mcp
MCP_COPILOT_ENABLED=true

# ── MCP: optional single legacy server ──────────────────────────
MCP_SERVER_URL=
MCP_SERVER_LABEL=lending-mcp
MCP_API_KEY=
MCP_ALLOWED_TOOLS=
MCP_APPROVAL_MODE=never

# ── Document Intelligence (optional — for document upload) ────────
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY=

# ── Cosmos DB (only when STORAGE_MODE=cosmos) ────────────────────
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DATABASE_NAME=loan-origination
COSMOS_CONTAINER_APPLICATIONS=applications
COSMOS_CONTAINER_DOCUMENTS=documents
COSMOS_CONTAINER_CONVERSATIONS=conversations
COSMOS_CONTAINER_AUDIT_EVENTS=audit_events

# ── Observability (only when OTEL_EXPORTER=azure) ────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Server ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8002
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178
