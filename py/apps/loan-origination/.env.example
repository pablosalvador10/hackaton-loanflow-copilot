# ── Runtime modes ────────────────────────────────────────────────
OTEL_EXPORTER=console

# ── Azure AI Foundry ─────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4-1-nano
FOUNDRY_CREDENTIAL_MODE=dev

# ── NHTSA API (public — no key needed) ──────────────────────────
NHTSA_API_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles

# ── Observability (when OTEL_EXPORTER=azure) ────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Server ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178
